{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "uv run --locked --no-dev python scripts/build_hosted.py",
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "includeFiles": "{src/waldofinder/**,hosted-assets/**,public/**}",
      "excludeFiles": "{tests/**,reports/**,experiments/**,image-assets/**,logo.png,docs/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "framework": "flask"
}
